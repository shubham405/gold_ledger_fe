# Copy to .env and adjust for your machine. Do not commit .env.

# Backend API (must match loan-management SERVER_PORT and host)
VITE_API_URL=http://localhost:8080/api/v1

# LAN / mobile testing: use your machine IP, e.g.
# VITE_API_URL=http://192.168.1.10:8080/api/v1

# Vite dev server (optional)
VITE_DEV_PORT=5173
VITE_DEV_HOST=0.0.0.0
