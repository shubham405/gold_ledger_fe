# Copy to .env and adjust for your machine. Do not commit .env.

# Backend API (must match loan-management SERVER_PORT and host)
# Must end with /api/v1 (not just the host)
VITE_API_URL=http://localhost:8080/api/v1

# Production example (Render + Vercel):
# VITE_API_URL=https://gold-ledger-be.onrender.com/api/v1

# LAN / mobile testing: use your machine IP, e.g.
# VITE_API_URL=http://192.168.1.10:8080/api/v1

# Request timeouts (ms) — stop waiting if API is slow/unreachable
VITE_API_TIMEOUT_MS=30000
VITE_API_DOWNLOAD_TIMEOUT_MS=120000

# Render cold start can take ~60s on free tier; raise if needed:
# VITE_API_TIMEOUT_MS=90000

# Vite dev server (optional)
VITE_DEV_PORT=5173
VITE_DEV_HOST=0.0.0.0
